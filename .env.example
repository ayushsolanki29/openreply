# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Temporary auth bypass — set to "true" to skip login entirely (dev/debug only)
BYPASS_AUTH=true
BYPASS_AUTH_EMAIL=admin@localhost
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
# Transaction-mode pooler — used at runtime (port 6543, works from Vercel/anywhere)
DATABASE_URL="postgresql://postgres.xxxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooler — used for migrations (port 5432)
DIRECT_URL="postgresql://postgres.xxxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"
REDIS_URL=redis://localhost:6379

# Email magic links (Resend) — required for login
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_...
# Must be a verified sender domain in your Resend account
EMAIL_FROM=OpenReply <no-reply@yourdomain.com>

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token
